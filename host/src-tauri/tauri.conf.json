{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RK98PRO Monitor",
  "identifier": "com.rk98pro.monitor",
  "mainBinaryName": "rk98pro-monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RK98PRO Monitor",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "RK98PRO read-only battery, status, WPM and notification monitor",
    "longDescription": "通过 USB 或 2.4G raw HID 只读 RK98PRO 的电量、充电、连接、键盘状态、WPM 与 RGB 状态，并提供桌面通知；不写入键盘，键盘配置仍由 VIA 完成。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-rk98pro.rules": "../packaging/99-rk98pro.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/99-rk98pro.rules": "../packaging/99-rk98pro.rules"
        }
      }
    }
  }
}
