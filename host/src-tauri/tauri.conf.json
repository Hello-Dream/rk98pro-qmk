{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RK98PRO Monitor",
  "version": "1.0.0",
  "identifier": "com.rk98pro.monitor",
  "mainBinaryName": "rk98pro-monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RK98PRO Monitor",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "RK98PRO battery, connection and keyboard settings",
    "longDescription": "通过 2.4G 接收器或有线连接读取 RK98PRO 的电量、充电状态和连接状态，并配置电源、侧灯与桌面通知。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
